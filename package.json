{
  "name": "stellane",
  "version": "0.2.0",
  "description": "Database context, verified memory and isolated experiments for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "stellane.patch.yml",
    "DEVELOPMENT.md",
    "PRODUCT.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "examples",
    "docs",
    "scripts/demo.mjs",
    "scripts/dev-neon.mjs",
    "scripts/neon-local-controller.mjs",
    "scripts/neon-local-runtime.mjs",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <=0.2.2-rc.3"
  },
  "packageManager": "pnpm@11.1.2",
  "dsh": {
    "bundle": {
      "patch": "stellane.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test": "node --test --experimental-strip-types tests/core.test.ts tests/onboarding.test.ts tests/neon.test.ts tests/state.test.ts tests/management.test.ts tests/neon-local.test.ts",
    "test:integration": "node --test --test-concurrency=1 --experimental-strip-types tests/postgres.test.ts tests/catalog.test.ts tests/knowledge.test.ts tests/community.test.ts tests/demo-data.test.ts tests/management-postgres.test.ts",
    "test:stello": "node --test --experimental-strip-types tests/stello.test.ts",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:stello": "python3 -B scripts/dev-stello.py",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:neon": "node --test --experimental-strip-types tests/neon.test.ts",
    "test:neon:live": "node --test --experimental-strip-types tests/neon-live.test.ts",
    "demo": "node scripts/demo.mjs",
    "demo:branches": "node dist/demo-branches.js",
    "test:demo": "node --test --experimental-strip-types tests/demo-data.test.ts",
    "prepack": "pnpm run build",
    "test:package": "node scripts/check-package.mjs",
    "dev:neon": "node scripts/dev-neon.mjs",
    "test:neon:local": "node --test --experimental-strip-types tests/neon-local-live.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <=0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <=0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.2-rc.1 <=0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^18.0.0",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "7.0.2",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czNail/Stellane.git"
  },
  "homepage": "https://github.com/czNail/Stellane#readme",
  "bugs": {
    "url": "https://github.com/czNail/Stellane/issues"
  },
  "keywords": [
    "dsh-plugin",
    "postgresql",
    "neon",
    "database",
    "data-lineage",
    "agent-memory",
    "database-branching"
  ],
  "bin": {
    "stellane-demo": "scripts/demo.mjs",
    "stellane-neon": "scripts/dev-neon.mjs"
  }
}
