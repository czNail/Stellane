{
  "name": "@stellane/harness-plugin",
  "version": "0.2.0-dev.1",
  "description": "PostgreSQL data environments for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "stellane.patch.yml",
    "DEVELOPMENT.md",
    "PRODUCT.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "packageManager": "pnpm@11.1.2",
  "dsh": {
    "bundle": {
      "patch": "stellane.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test": "node --test --experimental-strip-types tests/core.test.ts",
    "test:integration": "node --test --experimental-strip-types tests/postgres.test.ts",
    "test:stello": "node --test --experimental-strip-types tests/stello.test.ts",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:stello": "python3 -B scripts/dev-stello.py",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "pg": "8.23.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^18.0.0",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "7.0.2"
  }
}
